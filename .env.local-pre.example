# Real-Entra local PRE profile. Copy this file to .env.local-pre and run the
# BFF with launch profile https-local-pre-entra.
VITE_AUTH_MODE=entra
VITE_ENTRA_CLIENT_ID=77d0c0da-28fa-497c-abb1-92e4467e3fcb
VITE_ENTRA_TENANT_ID=3b6f65fd-e602-4e25-a81a-eb5ef7376512
VITE_BFF_SCOPE=api://6e5d71ad-3705-455b-bb0d-779331e46c78/access_as_user

# Leave empty so browser API calls stay same-origin and the Vite development
# proxy forwards them to the BFF HTTPS launch profile at https://localhost:7247.
VITE_BFF_BASE_URL=

VITE_APIM_PORTAL_URL=https://apim-cmn-pre.developer.azure-api.net/
VITE_APIM_GATEWAY_URL=https://apim-cmn-pre.azure-api.net/

# Documentation OAuth remains logically separate from portal login. Viewing
# specifications does not require authorizing this client.
VITE_DOCS_CLIENT_ID=76e21c21-a10d-45c2-ac0f-3d4e240a228c
VITE_DOCS_TENANT_ID=3b6f65fd-e602-4e25-a81a-eb5ef7376512
VITE_DOCS_REDIRECT_BASE_URL=http://localhost:5173
