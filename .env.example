# Public identifiers and endpoints. Copy this file to .env for local development.
VITE_APIM_SERVICE_NAME=apim-cmn-core
VITE_APIM_RESOURCE_GROUP=rg-common-core
VITE_AZURE_SUBSCRIPTION_ID=8b72e64a-ae1a-4ac3-9960-dda8ee63d59e
VITE_AZURE_TENANT_ID=3b6f65fd-e602-4e25-a81a-eb5ef7376512
VITE_AZURE_CLIENT_ID=76e21c21-a10d-45c2-ac0f-3d4e240a228c
VITE_APIM_PORTAL_URL=https://apim-cmn-core.developer.azure-api.net/
VITE_APIM_GATEWAY_URL=https://apim-cmn-core.azure-api.net/

# Standalone frontend data endpoint. Prefer an authenticated BFF/proxy instead
# of exposing Azure management-plane permissions directly to the browser.
VITE_APIM_DATA_API_BASE_URL=/api/apim
VITE_APIM_DATA_API_VERSION=

# Standalone portal authentication. Use a dedicated SPA registration; do not
# reuse VITE_AZURE_CLIENT_ID above, which remains documentation/OAuth-specific.
VITE_AUTH_MODE=mock
# Local mock only: "anonymous" or "authenticated". Production still requires Entra.
VITE_MOCK_AUTH_STATE=authenticated
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=3b6f65fd-e602-4e25-a81a-eb5ef7376512
VITE_BFF_SCOPE=
# Leave empty during local development to use the Vite /api proxy.
VITE_BFF_BASE_URL=

# OAuth client used only by Scalar/Swagger "try it" flows. This is a public
# browser client: use Authorization Code + PKCE and never configure a secret.
VITE_DOCS_CLIENT_ID=76e21c21-a10d-45c2-ac0f-3d4e240a228c
VITE_DOCS_TENANT_ID=3b6f65fd-e602-4e25-a81a-eb5ef7376512
VITE_DOCS_REDIRECT_BASE_URL=http://localhost:5173

# Documentation routes. The current widgets use the managed-portal hash format.
# The standalone application can switch these modes to "query".
VITE_DOCS_NATIVE_PATH=/api-details
VITE_DOCS_NATIVE_PARAMETER_MODE=hash
VITE_DOCS_SCALAR_PATH=/custom-api-details
VITE_DOCS_SCALAR_PARAMETER_MODE=hash
VITE_DOCS_SWAGGER_PATH=/custom-apis-swagger
VITE_DOCS_SWAGGER_PARAMETER_MODE=hash

# Deployment scripts use these server-side environment variables when set.
# APIM_SUBSCRIPTION_ID=
# APIM_RESOURCE_GROUP=
# APIM_SERVICE_NAME=
# AZURE_MANAGEMENT_API_ENDPOINT=https://management.azure.com
# AUTHENTICATION_MODE=Entra
# ENTRA_TENANT_ID=3b6f65fd-e602-4e25-a81a-eb5ef7376512
# ENTRA_BFF_AUDIENCE=
# AZURE_CLIENT_ID=  # optional user-assigned managed identity client ID
# OpenApi__CacheEntryLimit=50
# OpenApi__CacheDurationMinutes=15
# OpenApi__MaxDocumentBytes=10485760
# Catalog__CacheDurationMinutes=10
# Catalog__MaxConcurrentProductRequests=8
